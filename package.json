{
  "name": "chaton",
  "private": true,
  "version": "0.239.0",
  "description": "Chatons desktop assistant powered by Pi Coding Agent.",
  "author": "Thibaut Rey",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "postinstall": "electron-builder install-app-deps && node scripts/patch-model-registry.js && node scripts/patch-copilot-openai-completions.js",
    "commit": "node scripts/add-commit.js",
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:desktop\"",
    "dev:renderer": "vite",
    "dev:desktop": "npm run build:electron && wait-on tcp:5173 && env -u ELECTRON_RUN_AS_NODE VITE_DEV_SERVER_URL=http://localhost:5173 ./node_modules/.bin/electron dist-electron/electron/main.js",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "tsc -b && vite build",
    "build:electron": "rm -rf dist-electron && tsc -p tsconfig.electron.json && npm run build:builtin-extension-ui && npm run copy:electron-assets",
    "build:builtin-extension-ui": "node scripts/build-builtin-extension-ui.mjs",
    "copy:electron-assets": "node scripts/copy-electron-assets.js",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "version": "node scripts/version.js",
    "version:test": "node scripts/test-version.js",
    "dist": "npm run build && electron-builder --mac dmg",
    "package:prod:dmg": "node scripts/package-prod-dmg.js",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dev:cloud-api": "node apps/cloud-api/server.ts",
    "dev:cloud-realtime": "node apps/cloud-realtime/server.ts",
    "dev:runtime-headless": "node apps/runtime-headless/server.ts",
    "dev:cloud": "concurrently -k \"npm run dev:cloud-api\" \"npm run dev:cloud-realtime\" \"npm run dev:runtime-headless\"",
    "build:cloud": "tsc -p tsconfig.cloud.json && mkdir -p dist-cloud/packages/memory && cp packages/memory/index.js dist-cloud/packages/memory/index.js",
    "check:cloud": "npm run build:cloud",
    "check:pre-push": "npm run build && npm run check:cloud",
    "secrets:cloud": "node scripts/generate-cloud-secrets.js",
    "qa:electron-smoke": "node scripts/qa/electron-smoke.mjs",
    "qa:electron-smoke:dev": "CHATON_ELECTRON_SMOKE_MODE=dev node scripts/qa/electron-smoke.mjs",
    "qa:electron-smoke:file": "CHATON_ELECTRON_SMOKE_MODE=file node scripts/qa/electron-smoke.mjs",
    "qa:electron-smoke:app": "CHATON_ELECTRON_SMOKE_MODE=app node scripts/qa/electron-smoke.mjs",
    "qa:electron-smoke:interactive:dev": "CHATON_ELECTRON_SMOKE_MODE=dev CHATON_ELECTRON_SMOKE_FLOW=interactive node scripts/qa/electron-smoke.mjs",
    "qa:electron-smoke:interactive:file": "CHATON_ELECTRON_SMOKE_MODE=file CHATON_ELECTRON_SMOKE_FLOW=interactive node scripts/qa/electron-smoke.mjs",
    "qa:electron-smoke:fresh:file": "CHATON_ELECTRON_SMOKE_MODE=file CHATON_ELECTRON_SMOKE_FRESH_USER_DATA=1 node scripts/qa/electron-smoke.mjs",
    "qa:electron-smoke:blank:file": "CHATON_ELECTRON_SMOKE_MODE=file CHATON_ELECTRON_SMOKE_BLANK_USER_DATA=1 node scripts/qa/electron-smoke.mjs",
    "qa:electron-smoke:self-test:sqlite": "CHATON_ELECTRON_SMOKE_SELF_TEST=sqlite-snapshot node scripts/qa/electron-smoke.mjs",
    "qa:electron-smoke:self-test:signal": "CHATON_ELECTRON_SMOKE_SELF_TEST=signal-cleanup node scripts/qa/electron-smoke.mjs",
    "qa:electron-smoke:self-test:screenshot": "CHATON_ELECTRON_SMOKE_SELF_TEST=screenshot-analysis node scripts/qa/electron-smoke.mjs",
    "qa:electron-smoke:self-test:dev-server": "CHATON_ELECTRON_SMOKE_SELF_TEST=dev-server-preflight node scripts/qa/electron-smoke.mjs",
    "qa:electron-smoke:self-test:extension-server": "CHATON_ELECTRON_SMOKE_SELF_TEST=extension-server-shutdown CHATON_ELECTRON_SMOKE_ISOLATE_USER_DATA=1 node scripts/qa/electron-smoke.mjs",
    "qa:bug-log-smoke": "node scripts/qa/bug-log-smoke.mjs",
    "qa:bug-log-smoke:self-test:fixtures": "CHATON_BUG_LOG_SMOKE_SELF_TEST=fixtures node scripts/qa/bug-log-smoke.mjs",
    "qa:build-output-smoke": "node scripts/qa/build-output-smoke.mjs",
    "qa:build-output-smoke:self-test:fixtures": "CHATON_BUILD_OUTPUT_SMOKE_SELF_TEST=fixtures node scripts/qa/build-output-smoke.mjs",
    "qa:hygiene-smoke": "node scripts/qa/hygiene-smoke.mjs",
    "qa:hygiene-smoke:self-test:fixtures": "CHATON_QA_HYGIENE_SELF_TEST=fixtures node scripts/qa/hygiene-smoke.mjs",
    "qa:manifest-smoke": "node scripts/qa/qa-manifest-smoke.mjs",
    "qa:manifest-smoke:self-test:fixtures": "CHATON_QA_MANIFEST_SMOKE_SELF_TEST=fixtures node scripts/qa/qa-manifest-smoke.mjs",
    "qa:prod-ready-smoke": "node scripts/qa/prod-ready-smoke.mjs",
    "qa:prod-ready-smoke:dry-run": "CHATON_PROD_READY_DRY_RUN=1 node scripts/qa/prod-ready-smoke.mjs",
    "qa:prod-ready-smoke:build": "CHATON_PROD_READY_INCLUDE_BUILD=1 node scripts/qa/prod-ready-smoke.mjs",
    "qa:prod-ready-smoke:release": "CHATON_PROD_READY_INCLUDE_RELEASE=1 node scripts/qa/prod-ready-smoke.mjs",
    "qa:prod-ready-smoke:release:build": "CHATON_PROD_READY_INCLUDE_RELEASE=1 CHATON_PROD_READY_INCLUDE_BUILD=1 node scripts/qa/prod-ready-smoke.mjs",
    "qa:prod-ready-smoke:release:dry-run": "CHATON_PROD_READY_INCLUDE_RELEASE=1 CHATON_PROD_READY_DRY_RUN=1 node scripts/qa/prod-ready-smoke.mjs",
    "qa:prod-ready-smoke:release:build:dry-run": "CHATON_PROD_READY_INCLUDE_RELEASE=1 CHATON_PROD_READY_INCLUDE_BUILD=1 CHATON_PROD_READY_DRY_RUN=1 node scripts/qa/prod-ready-smoke.mjs",
    "qa:prod-ready-smoke:self-test:build": "CHATON_PROD_READY_INCLUDE_BUILD=1 CHATON_PROD_READY_SELF_TEST=build-steps node scripts/qa/prod-ready-smoke.mjs",
    "qa:prod-ready-smoke:self-test:env": "CHATON_PROD_READY_INCLUDE_RELEASE=1 CHATON_PROD_READY_INCLUDE_BUILD=1 CHATON_PROD_READY_SELF_TEST=env-isolation node scripts/qa/prod-ready-smoke.mjs",
    "qa:prod-ready-smoke:self-test:required": "CHATON_PROD_READY_SELF_TEST=required-steps node scripts/qa/prod-ready-smoke.mjs",
    "qa:reliability-smoke": "node scripts/qa/reliability-smoke.mjs",
    "qa:reliability-smoke:release": "CHATON_RELIABILITY_SMOKE_INCLUDE_RELEASE=1 node scripts/qa/reliability-smoke.mjs",
    "qa:reliability-smoke:self-test:env": "CHATON_RELIABILITY_SMOKE_INCLUDE_RELEASE=1 CHATON_RELIABILITY_SMOKE_SELF_TEST=env-isolation node scripts/qa/reliability-smoke.mjs",
    "qa:release-metadata-smoke": "node scripts/qa/release-metadata-smoke.mjs",
    "qa:release-metadata-smoke:self-test:fixtures": "CHATON_RELEASE_METADATA_SMOKE_SELF_TEST=fixtures node scripts/qa/release-metadata-smoke.mjs",
    "qa:release-smoke:mac": "node scripts/qa/mac-release-smoke.mjs",
    "qa:release-smoke:mac:dry-run": "CHATON_MAC_RELEASE_SMOKE_DRY_RUN=1 node scripts/qa/mac-release-smoke.mjs",
    "qa:release-smoke:mac:full": "CHATON_MAC_RELEASE_SMOKE_FULL=1 node scripts/qa/mac-release-smoke.mjs",
    "qa:release-smoke:mac:full:dry-run": "CHATON_MAC_RELEASE_SMOKE_FULL=1 CHATON_MAC_RELEASE_SMOKE_DRY_RUN=1 node scripts/qa/mac-release-smoke.mjs",
    "qa:release-smoke:mac:self-test:env": "CHATON_MAC_RELEASE_SMOKE_FULL=1 CHATON_MAC_RELEASE_SMOKE_SELF_TEST=env-isolation node scripts/qa/mac-release-smoke.mjs",
    "qa:dmg-smoke": "node scripts/qa/dmg-smoke.mjs",
    "qa:dmg-smoke:dry-run": "CHATON_DMG_SMOKE_DRY_RUN=1 node scripts/qa/dmg-smoke.mjs",
    "qa:dmg-smoke:install-copy": "CHATON_DMG_SMOKE_INSTALL_COPY=1 node scripts/qa/dmg-smoke.mjs",
    "qa:dmg-smoke:self-test:env": "CHATON_DMG_SMOKE_SELF_TEST=env node scripts/qa/dmg-smoke.mjs",
    "qa:dmg-smoke:self-test:install-copy-cleanup": "CHATON_DMG_SMOKE_SELF_TEST=install-copy-cleanup node scripts/qa/dmg-smoke.mjs"
  },
  "build": {
    "appId": "com.thibaut.chaton",
    "productName": "Chatons",
    "icon": "build/icons/icon",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/resources/npm{,/**}",
      "package.json",
      "build/icons/**/*"
    ],
    "extraResources": [
      {
        "from": "dist-electron/resources/npm",
        "to": "npm",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icons/icon.icns",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Chatons needs local network access to connect to self-hosted AI providers and local development services."
      },
      "type": "distribution",
      "notarize": false
    },
    "win": {
      "icon": "build/icons/icon.ico"
    },
    "dmg": {
      "artifactName": "${productName}-latest-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}Setup-latest.${ext}"
    },
    "linux": {
      "icon": "build/icons/icon.png",
      "artifactName": "${productName}-latest.${ext}"
    },
    "directories": {
      "output": "release"
    },
    "protocols": {
      "name": "Chatons",
      "schemes": [
        "chatons"
      ]
    }
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "^0.60.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/electron": "^7.10.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "follow-redirects": "^1.16.0",
    "framer-motion": "^12.38.0",
    "i18next": "^25.8.18",
    "isomorphic-git": "^1.37.4",
    "lucide-react": "^0.577.0",
    "nodemailer": "8.0.8",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "redis": "^5.11.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron": "^1.6.12",
    "@types/follow-redirects": "^1.14.4",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "7.0.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "electron": "^41.7.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.4.0",
    "npm": "^11.15.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.2.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "wait-on": "^9.0.10"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.8.0",
    "cron": "^4.4.0"
  },
  "overrides": {
    "@aws-sdk/xml-builder": "3.972.25",
    "fast-xml-parser": "5.8.0",
    "yaml": "2.8.3",
    "picomatch": "4.0.4",
    "brace-expansion": "5.0.6",
    "basic-ftp": "5.3.1",
    "fast-uri": "3.1.2",
    "ip-address": "10.2.0",
    "protobufjs": "7.6.1",
    "ws": "8.21.0",
    "@xmldom/xmldom": "0.9.10",
    "plist": "3.1.1",
    "lodash": "4.18.1",
    "minimatch@3": {
      "brace-expansion": "1.1.13"
    },
    "minimatch@5": {
      "brace-expansion": "2.0.3"
    },
    "minimatch@9": {
      "brace-expansion": "2.0.3"
    },
    "npm": {
      "brace-expansion": "5.0.6",
      "tinyglobby": {
        "picomatch": "4.0.4"
      }
    }
  }
}
